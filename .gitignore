# Python
__pycache__/
*.pyc
.venv/
venv/

# Data — do NOT commit datasets (see data/README.md)
data/*
!data/README.md
!data/big2015_subset.txt
!data/.gitkeep

# Results: the small per-seed result files, summaries and figures of the final run
# ARE committed, so `make reproduce` can rebuild metrics.json and the paper tables
# without the datasets. Fold assignments (results/splits/) are regenerated.
results/*
!results/.gitkeep
!results/metrics.json
!results/e1/
!results/e2/
!results/e3/
!results/e4/
!results/dedup_threshold/
results_quick/
results_ci/
logs/

# Grading harness output (regenerated by grading/grade.py)
grading/auto_report.json

# OS / editor
.DS_Store
.vscode/
.idea/
